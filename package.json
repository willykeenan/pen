{
  "name": "@kestudios/pen-mcp",
  "version": "0.2.1",
  "description": "The local MCP connector for Pen by KE Studios — point at the screen and let your AI get the point.",
  "type": "module",
  "bin": {
    "ke-pen-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist/mcp",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run build:mcp && npm run build:app",
    "build:mcp": "tsc -p tsconfig.json && npm run bundle:mcp && chmod +x dist/mcp/index.js dist/mcp-app/index.js",
    "bundle:mcp": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/mcp-app/index.js",
    "build:app": "bash scripts/build-app.sh",
    "check": "npm run typecheck && npm test && swift test",
    "verify:bundle": "node scripts/verify-bundled-mcp.mjs dist/Pen.app/Contents/Resources/mcp/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start:mcp": "node dist/mcp/index.js",
    "prepack": "npm run build:mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pen",
    "macos",
    "screen",
    "annotation",
    "ke-studios",
    "kestudios"
  ],
  "author": "William Keenan <william@kestudios.dev> (https://kestudios.dev)",
  "homepage": "https://kestudios.dev/?ref=pen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willykeenan/pen.git"
  },
  "bugs": "https://github.com/willykeenan/pen/issues",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
